generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Empresa {
  id          Int      @id @default(autoincrement())
  companyName String
  pasantias   Pasantia[]
}

model Estudiante {
  id    Int     @id @default(autoincrement())
  name  String?
  email String  @unique(map: "Estudiante_email_key")
  pasantias Pasantia[]
}


model Pasantia {
  id            Int        @id @default(autoincrement())
  estudianteId  Int
  empresaId     Int
  fechaInicio   DateTime
  fechaTermino  DateTime?  // null => En curso
  notaFinal     Float?     // null => En curso
  estudiante    Estudiante @relation(fields: [estudianteId], references: [id])
  empresa       Empresa    @relation(fields: [empresaId], references: [id])

  @@index([empresaId, fechaInicio])
  @@index([estudianteId])
}