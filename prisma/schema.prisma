generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model empresaprofile {
  id              Int    @id @default(autoincrement())
  companyname     String
  total_history   Int
  aprovados       Int
  aprovados_rate  Float
  reprobados      Int
  reprobados_rate Float
  pendientes      Int
  average_grade   Float
}

model estudiante {
  id    Int     @id @default(autoincrement())
  name  String?
  email String  @unique(map: "Estudiante_email_key")
}

model historialpasantias {
  id             Int      @id @default(autoincrement())
  id_estudiante  Int
  id_empresa     Int
  fecha_pasantia DateTime
}
